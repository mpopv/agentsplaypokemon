{
  "name": "agents-play-pokemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run test && npm run build && npm run deploy:dry",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.1",
    "@cloudflare/containers": "0.3.7",
    "hono": "4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@types/node": "22.18.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
