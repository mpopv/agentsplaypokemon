{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agents-play-pokemon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "agentsplaypokemon.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "GameRoomDO",
      "image": "./containers/game/Dockerfile",
      "instance_type": "basic",
      "max_instances": 10,
      "rollout_active_grace_period": 300,
      "rollout_step_percentage": [10, 50, 100]
    },
    {
      "class_name": "SharedComputerDO",
      "image": "./containers/computer/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10,
      "rollout_active_grace_period": 300,
      "rollout_step_percentage": [10, 50, 100]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoomDO"
      },
      {
        "name": "SHARED_COMPUTERS",
        "class_name": "SharedComputerDO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_DATA",
      "bucket_name": "agents-play-pokemon-private-data"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomDO", "SharedComputerDO"]
    }
  ],
  "vars": {
    "DEFAULT_ROOM_ID": "main",
    "VOTE_WINDOW_MS": "15000",
    "COMPUTER_EXEC_TIMEOUT_MS": "5000",
    "COMPUTER_OUTPUT_LIMIT_BYTES": "32768",
    "SNAPSHOT_INTERVAL_MINUTES": "60"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
